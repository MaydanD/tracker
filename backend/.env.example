# Copy to backend/.env to override defaults. Every setting uses the TRACKER_
# prefix; unknown keys are rejected on purpose so typos fail loudly.
# This file is optional — the defaults below are the values the app already uses.

# development | test | production
TRACKER_APP_ENV=development

TRACKER_HOST=127.0.0.1
TRACKER_PORT=8000
TRACKER_LOG_LEVEL=INFO

# Origins allowed to call the API from a browser. Comma-separated.
TRACKER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where runtime data (tracker.db and, later, backups) is stored.
# Defaults to <repository>/.data in development,
# %LOCALAPPDATA%\Tracker for a packaged build.
# TRACKER_DATA_DIR=C:/Users/you/TrackerData

# Full SQLAlchemy URL. Overrides TRACKER_DATA_DIR when set.
# TRACKER_DATABASE_URL=sqlite+pysqlite:///C:/Users/you/TrackerData/tracker.db

# Logical ZIP import: 64 MiB compressed, 256 MiB expanded JSON.
TRACKER_BACKUP_MAX_UPLOAD_BYTES=67108864
TRACKER_BACKUP_MAX_UNCOMPRESSED_BYTES=268435456
