# Copy to frontend/.env.local to override. All client variables must be
# prefixed with VITE_.

# Base URL of the Tracker API. Leave empty during development: the Vite dev
# server proxies /api to the backend (see vite.config.ts), so relative URLs work.
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Where the dev-server proxy sends /api. Only needed if the backend runs on a
# non-default port. Set it in the shell, or here for `vite dev` via .env.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
